    characterSetSelectionMode: 8
    characterSequence: "\u8D77\u59CB\u4F4D\u7F6E\u7EC8\u6B62\u9AD8\u5EA6\u5BBD\u4FEF\u89C6\u56FE\u622A\u9762\u8FD0\u884C_\u6CE5\u6C99\u51B2\u5237\u91CF\u704C\u6E89\u4F9B\u6C34\u91CF\u4E0D\u8DB3\u4FEE\u6539\u8C03\u6574\u4F4D\u7F6E\u8BF7\u5F53\u524D\u6D41\u901F\u8BF7\u6CBF\u865A\u7EBF\u786E\u5B9A\u5830\u7684\u4F4D\u7F6E\u9F20\u6807\u6309\u4E0B\u4E3A\u8D77\u70B9\u9F20\u6807\u677E\u5F00\u4E3A\u7EC8\u70B9\u6211\uFF08\u6CE8\u89C6\u7740\u6C79\u6D8C\u7684\u6C34\u6D41\uFF09\u6CA1\u60F3\u5230\uFF0C\u8FD9\u822C\u6FC0\u6D41\uFF0C\u7ADF\u4E5F\u80FD\u88AB\u4EBA\u529B\u8F7B\u677E\u5316\u89E3\u3002\u674E\u51B0\uFF08\u76EE\u5149\u4F9D\u65E7\u6CE8\u89C6\u7740\u6ED4\u6ED4\u6C5F\u6C34\uFF0C\u8BED\u6C14\u6C89\u7A33\uFF09\u6C34\u4E4B\u529B\uFF0C\u6C79\u6D8C\u800C\u4E0D\u53EF\u6321\uFF0C\u7136\u82E5\u80FD\u638C\u63A7\u5176\u8109\u7EDC\uFF0C\u4FBF\u53EF\u5316\u654C\u4E3A\u53CB\u3002\u4EBA\u529B\u867D\u6E3A\u5C0F\uFF0C\u7136\u82E5\u5F97\u5F53\uFF0C\u80FD\u501F\u5929\u5730\u4E4B\u52BF\uFF0C\u8FD0\u7528\u5DE7\u5999\u4E4B\u6CD5\uFF0C\u4FBF\u80FD\u8C03\u52A8\u6C34\u6D41\uFF0C\u4F7F\u4E4B\u4E3A\u6211\u6240\u7528\u3002\u4EE5\u6B64\u6CD5\u8C03\u6C34\uFF0C\u5185\u5916\u6C5F\u9053\u5F97\u4EE5\u5206\u6D41\uFF0C\u65E2\u80FD\u4FDD\u969C\u5E73\u539F\u704C\u6E89\uFF0C\u53C8\u80FD\u9632\u6B62\u6D2A\u6C34\u6CDB\u6EE5\u3002\u4E07\u5343\u6C34\u6D41\uFF0C\u7686\u5728\u638C\u63E1\u4E4B\u4E2D\u3002\u6C34\uFF0C\u975E\u4E0D\u53EF\u6CBB\uFF0C\u800C\u662F\u6CBB\u4E4B\u9700\u5DE7\u601D\u4E0E\u6052\u5FC3\u3002\u6211\uFF08\u604D\u7136\u5927\u609F\uFF0C\u4F4E\u5934\u884C\u793C\uFF09\u5B69\u513F\u53D7\u6559\u4E86\uFF0C\u7236\u4EB2\u7684\u6559\u8BF2\u5982\u918D\u9190\u704C\u9876\uFF0C\u8C41\u7136\u5F00\u6717\u3002\u6C34\u6D41\u7684\u5206\u914D\u4E0E\u638C\u63A7\uFF0C\u786E\u5B9E\u662F\u8FD9\u5DE5\u7A0B\u7684\u5173\u952E\u6240\u5728\u3002\u7CBE\u51C6\u628A\u63E1\u5176\u4E2D\u7684\u5FAE\u5999\uFF0C\u4FBF\u80FD\u5316\u89E3\u8FD9\u96BE\u9898\uFF0C\u9020\u798F\u767E\u59D3\u3002\u591A\u8C22\u7236\u4EB2\u6307\u70B9\uFF0C\u5B69\u513F\u5FC5\u5B9A\u8C28\u8BB0\u5FC3\u4E2D\u3002NPC\u201C\u51E1\u5824\u6709\u51B2\u51B3\u4E4B\u865E\uFF0C\u5FC5\u7B51\u5206\u6C34\u4E4B\u6E20\uFF0C\u4EE5\u6740\u6C34\u52BF\uFF0C\u6563\u6C34\u529B\u800C\u56FA\u5176\u6839\u3002\u201D\u51FA\u81EA\u5F90\u5149\u542F\u7684\u300A\u519C\u653F\u5168\u4E66\u300B\u3002\u5F3A\u8C03\u5728\u5824\u575D\u65C1\u4FEE\u7B51\u5206\u6C34\u6E20\uFF0C\u51CF\u8F7B\u6C34\u6D41\u51B2\u51FB\u3002NPC\u606D\u559C\u60A8\u6210\u529F\u5B8C\u6210\u672C\u5173\u6311\u6218\uFF0C\u83B7\u5F97\u5BF9\u5E94\u5730\u56FE\u788E\u7247\u3002\u63A5\u4E0B\u6765\u8BF7\u524D\u5F80xxxx\u5173\u5361\uFF0C\u7EE7\u7EED\u90FD\u6C5F\u5830\u7684\u5EFA\u8BBE\u5427\u3002\u674E\u51B0\u7ADF\u4E0D\u77E5\u4E8C\u90CE\u4F60\u7ADF\u85CF\u6709\u5982\u6B64\u624D\u667A\uFF0C\u80FD\u63D0\u51FA\u6B64\u7B49\u7EDD\u5999\u4E4B\u6CD5\uFF0C\u89E3\u4E86\u4E3A\u7236\u4E00\u5927\u96BE\u9898\u6211\u6B64\u5E76\u975E\u6211\u7684\u529F\u52B3\uFF0C\u5B9E\u4E0D\u8FC7\u662F\u501F\u9274\u524D\u4EBA\u7ECF\u9A8C\u4E0E\u667A\u6167\u800C\u5DF2\u3002NPC\u201C\u706B\u529B\u5230\u540E\uFF0C\u70E7\u9165\u77F3\u6027\uFF0C\u7F6E\u4E8E\u98CE\u4E2D\uFF0C\u4E45\u81EA\u5439\u5316\u6210\u7C89\u3002\u6025\u7528\u8005\u4EE5\u6C34\u6C83\u4E4B\uFF0C\u4EA6\u81EA\u89E3\u6563\u3002\u201D\u51FA\u81EA\u300A\u5929\u5DE5\u5F00\u7269\u300B\uFF0C\u5176\u4F5C\u8005\u4E3A\u660E\u4EE3\u79D1\u5B66\u5BB6\u5B8B\u5E94\u661F\u3002\u610F\u601D\u662F\u706B\u5019\u8DB3\u540E\uFF0C\u77F3\u5934\u5C31\u4F1A\u53D8\u8106\u3002\u653E\u5728\u7A7A\u6C14\u4E2D\u4F1A\u6162\u6162\u98CE\u5316\u6210\u7C89\u672B\u3002\u7740\u6025\u7528\u7684\u65F6\u5019\u6D12\u4E0A\u6C34\uFF0C\u4E5F\u4F1A\u81EA\u52A8\u6563\u5F00\u3002NPC\u606D\u559C\u60A8\u6210\u529F\u5B8C\u6210\u672C\u5173\u6311\u6218\uFF0C\u83B7\u5F97\u5BF9\u5E94\u5730\u56FE\u788E\u7247\u3002\u63A5\u4E0B\u6765\u8BF7\u524D\u5F80xxxx\u5173\u5361\uFF0C\u7EE7\u7EED\u90FD\u6C5F\u5830\u7684\u5EFA\u8BBE\u5427\u3002NPC\u5CB7\u6C5F\u6CBF\u5CB8\u7684\u767E\u59D3\u82E6\u4E8E\u6C34\u60A3\u4E0E\u65F1\u707E\u4E4B\u56F0\uFF0C\u751F\u7075\u6D82\u70AD\uFF0C\u767E\u59D3\u547C\u53F7\uFF0C\u54C0\u9E3F\u904D\u91CE\u3002\u4E3A\u4E86\u89E3\u6551\u82CD\u751F\uFF0C\u666E\u60E0\u767E\u91CC\u4E4B\u5730\uFF0C\u674E\u51B0\u8BBE\u8BA1\u4E86\u8FD9\u9879\u6C34\u5229\u5DE5\u7A0B\u2014\u2014\u90FD\u6C5F\u5830\uFF0C\u610F\u5728\u5F7B\u5E95\u6CBB\u7406\u6D2A\u6C34\uFF0C\u8C03\u5F15\u6C5F\u6C34\u704C\u6E89\u6210\u90FD\u5E73\u539F\uFF0C\u8BA9\u8FD9\u7247\u6C83\u571F\u6C38\u4EAB\u4E30\u9976\u3002NPC\u5DE5\u7A0B\u7684\u7B2C\u4E00\u6B65\u4FBF\u662F\u5F00\u51FF\u7389\u5792\u5C71\u5C3E\u90E8\uFF0C\u5EFA\u7ACB\u5206\u6C34\u53E3\u2014\u2014\u5B9D\u74F6\u53E3\uFF0C\u8FD9\u662F\u8FD9\u9879\u6C34\u5229\u5927\u8BA1\u7684\u5173\u952E\u6240\u5728\u3002\u674E\u51B0\uFF08\u5FE7\u5FC3\u5FE1\u5FE1\uFF09\u5C71\u4F53\u575A\u786C\uFF0C\u4EBA\u529B\u96BE\u53CA\u3002\u6211\u4EEC\u8FD9\u6837\u611A\u516C\u79FB\u5C71\uFF0C\u7A76\u7ADF\u4F55\u65F6\u624D\u80FD\u5F00\u51FF\u51FA\u4E00\u4E2A\u53E3\u5B50\u3002\u5509\uFF01\u8FD9\u6B21\u5EFA\u9020\u96BE\u9053\u53EA\u80FD\u6B62\u6B65\u4E8E\u6B64\uFF1F\u674E\u4E8C\u90CE\uFF08\u8111\u6D77\u4E2D\u7075\u5149\u4E00\u95EA\uFF09\u7236\u4EB2\uFF0C\u6211\u6709\u4E00\u8BA1\u3002\u674E\u4E8C\u90CE\u2018\u706B\u529B\u5230\u540E\uFF0C\u70E7\u9165\u77F3\u6027\uFF0C\u7F6E\u4E8E\u98CE\u4E2D\uFF0C\u4E45\u81EA\u5439\u5316\u6210\u7C89\u3002\u6025\u7528\u8005\u4EE5\u6C34\u6C83\u4E4B\uFF0C\u4EA6\u81EA\u89E3\u6563\u3002\u2019\u6216\u8BB8\u501F\u52A9\u706B\u4E0E\u6C34\u7684\u529B\u91CF\uFF0C\u7ED3\u5408\u81EA\u7136\u7684\u53D8\u6362\uFF0C\u53EF\u4EE5\u6253\u7834\u8FD9\u5CA9\u77F3\u7684\u575A\u786C\u3002NPC\u5728\u90FD\u6C5F\u5830\u7684\u4FEE\u5EFA\u8FC7\u7A0B\u521D\u671F\uFF0C\u5DE8\u5927\u7684\u5CA9\u77F3\u9996\u5148\u6210\u4E3A\u969C\u788D\u3002\u4E3A\u4E86\u987A\u5229\u89E3\u51B3\u8FD9\u4E00\u95EE\u9898\uFF0C\u4F60\u9700\u8981\u4ED4\u7EC6\u89C2\u5BDF\u5C71\u4F53\uFF0C\u627E\u5230\u8F83\u4E3A\u677E\u6563\u6216\u6709\u5929\u7136\u88C2\u7F1D\u7684\u4F4D\u7F6E\uFF0C\u5E76\u6807\u8BB0\u4E3A\u5F00\u51FF\u70B9\u3002\u5229\u7528\u706B\u5806\u3001\u51B0\u6C34\u6876\u6539\u53D8\u5CA9\u77F3\u6E29\u5EA6\uFF0C\u4F7F\u4E4B\u5D29\u88C2\u3002\u6210\u529F\u6E05\u7406\u5CA9\u77F3\u540E\uFF0C\u89C6\u4F5C\u5173\u5361\u6311\u6218\u6210\u529F\uFF0C\u5C06\u83B7\u5F97\u76F8\u5E94\u5956\u52B1\u3002\u674E\u51B0\uFF08\u773A\u671B\u8FDC\u65B9\uFF0C\u6CE8\u89C6\u7740\u5954\u817E\u7684\u5CB7\u6C5F\u6CB3\u6D41\uFF09\u4E8C\u90CE\uFF0C\u4F60\u770B\uFF0C\u8FD9\u5CB7\u6C5F\u4E4B\u6C34\uFF0C\u5982\u4ECA\u5DF2\u88AB\u6211\u4EEC\u9A6F\u670D\u3002\u8FD9\u9879\u5DE5\u7A0B\uFF0C\u65E2\u89E3\u51B3\u4E86\u6C34\u60A3\u4E4B\u5FE7\uFF0C\u53C8\u89E3\u51B3\u4E86\u767E\u59D3\u704C\u6E89\u4E4B\u82E6\u3002\u6211\u4EEC\u867D\u4E0D\u80FD\u957F\u751F\uFF0C\u4F46\u80FD\u4E3A\u767E\u59D3\u7559\u4E0B\u8FD9\u5343\u5E74\u4E0D\u673D\u7684\u5DE5\u7A0B\uFF0C\u4FBF\u662F\u6700\u5927\u7684\u6210\u5C31\u3002\u674E\u4E8C\u90CE\uFF08\u76EE\u5149\u575A\u5B9A\uFF0C\u5FAE\u5FAE\u70B9\u5934\uFF09\u7236\u4EB2\uFF0C\u60A8\u8BF4\u5F97\u5BF9\u3002\u60A8\u5E38\u6559\u5BFC\u6211\u987A\u5E94\u81EA\u7136\u3001\u56E0\u52BF\u5229\u5BFC\u3002\u5982\u4ECA\u8FD9\u9C7C\u5634\u5206\u6C34\u3001\u98DE\u6C99\u5830\u6CC4\u6D2A\u3001\u5B9D\u74F6\u53E3\u5F15\u6C34\uFF0C\u6BCF\u4E00\u5904\u90FD\u5DE7\u5999\u5730\u5229\u7528\u4E86\u81EA\u7136\u7684\u529B\u91CF\u3002\u674E\u51B0\uFF08\u4F4E\u5934\u601D\u7D22\uFF0C\u8BED\u91CD\u5FC3\u957F\uFF09\u662F\u554A\uFF0C\u987A\u5E94\u81EA\u7136\uFF0C\u56E0\u52BF\u5229\u5BFC\uFF0C\u8FD9\u4FBF\u662F\u6211\u4EEC\u6CBB\u6C34\u7684\u6839\u672C\u3002\u6DF1\u6DD8\u6EE9\uFF0C\u4F4E\u4F5C\u5830\u3002\u8FD9\u516B\u4E2A\u5B57\uFF0C\u662F\u81EA\u7136\u7ED9\u4E88\u6211\u4EEC\u7684\u7ECF\u9A8C\uFF0C\u4E5F\u662F\u6211\u4EEC\u7559\u7ED9\u540E\u4EBA\u7684\u667A\u6167\u3002NPC\u201C\u4EE5\u4EBA\u6CBB\u6CB3\uFF0C\u4E0D\u5982\u4EE5\u6CB3\u6CBB\u6CB3\u3002\u5982\u6B32\u6DF1\u5317\uFF0C\u5219\u5357\u5176\u5824\u800C\u5317\u81EA\u6DF1\u3002\u5982\u6B32\u6DF1\u5357\u5219\u5317\u5176\u5824\u800C\u5357\u81EA\u6DF1\u3002\u201D\u51FA\u81EA\u300A\u6CB3\u5357\u901A\u6CBB\u300B\uFF0C\u610F\u601D\u662F\u4E0E\u5176\u9760\u4EBA\u6765\u6CBB\u6CB3\uFF0C\u4E0D\u5982\u8BA9\u6CB3\u81EA\u5DF1\u6CBB\u81EA\u5DF1\u3002\u5982\u679C\u60F3\u8BA9\u5317\u8FB9\u7684\u6CB3\u5E8A\u53D8\u6DF1\uFF0C\u5C31\u5411\u5357\u7B51\u5824\uFF0C\u5317\u8FB9\u81EA\u7136\u5C31\u4F1A\u6DF1\u4E86\u3002NPC\u606D\u559C\u4F60\u5DF2\u7ECF\u5B8C\u6210\u90FD\u6C5F\u5830\u7684\u5168\u90E8\u5EFA\u8BBE\uFF0C\u83B7\u5F97\u672C\u8F6E\u5173\u5361\u5730\u56FE\u788E\u7247\u3002\u63A5\u4E0B\u6765\u8BF7\u524D\u5F80\u594F\u4E50\u7AE0\u8282\uFF0C\u4E00\u8D77\u5E86\u795D\u90FD\u6C5F\u5830\u7684\u6210\u529F\u5EFA\u8BBE\u5427\uFF01NPC\u90FD\u6C5F\u5830\u7684\u6C34\u5229\u5DE5\u7A0B\u5DF2\u521D\u89C1\u96CF\u5F62\uFF0C\u7136\u800C\u73B0\u5728\u4F60\u4EEC\u9762\u4E34\u4E00\u4E2A\u65B0\u7684\u95EE\u9898\u5982\u4F55\u89E3\u51B3\u6CE5\u6C99\u5806\u79EF\u5728\u5B9D\u74F6\u53E3\u7684\u95EE\u9898\u5462\uFF1F\u674E\u51B0\uFF08\u7AD9\u5728\u5B9D\u74F6\u53E3\uFF0C\u9762\u5BF9\u7740\u90FD\u6C5F\u5830\uFF0C\u795E\u8272\u51DD\u91CD\uFF0C\u4F3C\u4E4E\u5728\u601D\u8003\u7740\u4EC0\u4E48\u2026\u2026\uFF09\u674E\u4E8C\u90CE\u90FD\u6C5F\u5830\u5DF2\u521D\u89C1\u96CF\u5F62\uFF0C\u7236\u4EB2\u53EF\u8FD8\u6709\u4EC0\u4E48\u7591\u8651\uFF1F\u674E\u51B0\uFF08\u9065\u6307\u9C7C\u5634\uFF09\u4E8C\u90CE\uFF0C\u4F60\u770B\uFF0C\u9C7C\u5634\u5DF2\u7ECF\u5C06\u5CB7\u6C5F\u5206\u6210\u4E86\u5185\u6C5F\u548C\u5916\u6C5F\u3002\u800C\u5CB7\u6C5F\u643A\u5E26\u7684\u5927\u90E8\u5206\u7684\u6CE5\u6C99\u90FD\u5728\u5916\u6C5F\u6C89\u79EF\uFF0C\u4F60\u77E5\u9053\u662F\u4E3A\u4EC0\u4E48\u5417\uFF1F\u674E\u4E8C\u90CE\u662F\u56E0\u4E3A\u5185\u6C5F\u5904\u4E8E\u51F9\u5CB8\uFF0C\u5916\u6C5F\u5904\u4E8E\u51F8\u5CB8\uFF0C\u51F9\u5CB8\u6613\u53D7\u6CB3\u6D41\u4FB5\u8680\uFF0C\u800C\u51F8\u5CB8\u6613\u5806\u79EF\u6CE5\u6C99\u3002\u674E\u51B0\uFF08\u8D5E\u8D4F\u7684\u773C\u795E\uFF09\u4E0D\u9519\u3002\u7136\u800C\u5373\u4FBF\u5982\u6B64\uFF0C\u5185\u6C5F\u6254\u643A\u5E26\u6709\u90E8\u5206\u6CE5\u6C99\uFF0C\u6C34\u6D41\u5230\u5B9D\u74F6\u53E3\u9644\u8FD1\u5448\u56DE\u65CB\u72B6\uFF0C\u6CE5\u6C99\u6C89\u79EF\u4F1A\u4F7F\u5B9D\u74F6\u53E3\u88AB\u5835\u585E\uFF0C\u4E8C\u90CE\uFF0C\u4F60\u53EF\u6709\u4EC0\u4E48\u597D\u4E3B\u610F\uFF1F\u674E\u4E8C\u90CE\u6211\u4EE5\u4E3A\uFF0C\u6CB3\u6D41\u51B2\u51FB\u5230\u5B9D\u74F6\u53E3\uFF0C\u5728\u79BB\u5806\u7684\u9876\u6258\u4E0B\u6C34\u6D41\u5448\u65CB\u6DA1\u72B6\uFF0C\u4E0D\u5982\u501F\u529B\u4F7F\u529B\uFF0C\u8BA9\u8FD9\u6C34\u4E2D\u7684\u7802\u77F3\u5728\u8FD9\u513F\u88AB\u7529\u51FA\u53BB\u3002\u674E\u51B0\uFF08\u629A\u6478\u80E1\u987B\uFF0C\u70B9\u70B9\u5934\uFF09\u4F9D\u4F60\u770B\uFF0C\u8BE5\u5982\u4F55\u8BA9\u7802\u77F3\u7529\u51FA\u53BB\u5462\uFF1F\u674E\u4E8C\u90CE\uFF08\u575A\u6BC5\u7684\u773C\u795E\uFF09\u4E0D\u5982\u5728\u79BB\u5806\u7684\u76F8\u5BF9\u5904\u4FEE\u5EFA\u4E00\u4E2A\u5830\uFF0C\u8FD9\u6837\u6CE5\u6C99\u5C31\u80FD\u88AB\u7529\u51FA\u53BB\u3002\u800C\u4E14\uFF0C\u5F53\u5185\u6C5F\u6C34\u6D41\u591A\u65F6\uFF0C\u5B83\u8FD8\u80FD\u5145\u5F53\u7B2C\u4E8C\u6B21\u6CC4\u6D2A\u7684\u4F5C\u7528\u3002\u674E\u51B0\uFF08\u80AF\u5B9A\u9053\uFF09\u65E2\u5982\u6B64\uFF0C\u6B64\u5830\u4E0D\u5982\u5C31\u53EB\u505A\u98DE\u6C99\u5830\u5427\u3002NPC\u672C\u8F6E\u5173\u5361\u73A9\u5BB6\u9700\u901A\u8FC7\u8C03\u6574\u98DE\u6C99\u5830\u9AD8\u5EA6\uFF0C\u5229\u7528\u6C34\u6D41\u5E26\u8D70\u5185\u6C5F\u7684\u6CE5\u6C99\uFF0C\u9632\u6B62\u6DE4\u79EF\u3002NPC\u73B0\u5728\u8FDB\u5165\u5230\u6700\u540E\u4E00\u4E2A\u90E8\u5206\uFF0C\u90FD\u6C5F\u5830\u5DE5\u7A0B\u5DF2\u7ECF\u5B8C\u7F8E\u7AE3\u5DE5\uFF0C\u201C\u51E1\u4E50\u4E8B\uFF0C\u4EE5\u949F\u9F13\u594F\u4E5D\u590F\u201D\u3002\u73B0\u5728\u8BF7\u4F60\u6F14\u594F\u4E50\u5668\u4EE5\u8868\u5E86\u795D\u3002NPC\u672C\u8F6E\u5173\u5361\u73A9\u5BB6\u9700\u8981\u8DDF\u968F\u97F3\u4E50\u7684\u8282\u594F\uFF0C\u5728\u5408\u9002\u7684\u65F6\u95F4\u6572\u51FB\u7F16\u949F\uFF0C\u4EE5\u5B8C\u6210\u4E00\u9996\u97F3\u4E50\u7684\u6F14\u594F\u3002NPC\u606D\u559C\u4F60\u5B8C\u6210\u6700\u540E\u4E00\u8F6E\u5173\u5361\u7684\u6311\u6218\uFF0C\u6210\u529F\u83B7\u5F97\u6700\u540E\u4E00\u5757\u5730\u56FE\u788E\u7247\u3002NPC\u606D\u559C\u4F60\u5DF2\u7ECF\u96C6\u9F50\u90FD\u6C5F\u5830\u7684\u6240\u6709\u788E\u7247\uFF0C\u6210\u529F\u5B8C\u6210\u90FD\u6C5F\u5830\u7684\u5EFA\u8BBE\uFF0C\u9020\u798F\u4E00\u65B9\u767E\u59D3\u3002NPC\u671F\u5F85\u4E0E\u4F60\u7684\u518D\u6B21\u76F8\u89C1\uFF0C\u7CFB\u7EDF\u7AED\u8BDA\u4E3A\u4F60\u670D\u52A1\u3002NPC\uFF08\u5728\u8111\u6D77\u4E2D\u54CD\u8D77\uFF09\u5BBF\u4E3B\uFF0C\u60A8\u597D\u3002\u674E\u4E8C\u90CE\uFF08\u60CA\u6050\uFF09\u60A8\u662F\u8C01\uFF0C\u600E\u4E48\u5728\u6211\u8111\u6D77\u91CC\uFF01NPC\u6211\u662F\u60A8\u7684\u5C0F\u52A9\u624B\u3002\u60A8\u53EA\u9700\u77E5\u9053\uFF0C\u7CFB\u7EDF\u68C0\u6D4B\u5230\u60A8\u4E0E\u4E8C\u90CE\u795E\u7684\u547D\u8FD0\u7EBF\u53D7\u65F6\u7A7A\u5F71\u54CD\uFF0C\u53D1\u751F\u6CE2\u52A8\uFF0C\u73B0\u5DF2\u5C06\u60A8\u4F20\u9001\u81F3\u4E8C\u90CE\u795E\u51E1\u80CE\u2014\u2014\u674E\u4E8C\u90CE\u4E4B\u8EAB\u3002\u8BF7\u7AED\u529B\u5E2E\u52A9\u674E\u4E8C\u90CE\u53CA\u5176\u7236\u674E\u51B0\u5B8C\u6210\u90FD\u6C5F\u5830\u7684\u4FEE\u5EFA\uFF0C\u7406\u6E05\u547D\u8FD0\u7EBF\uFF0C\u89E3\u9664\u7EA0\u845B\uFF0C\u56DE\u5230\u73B0\u5B9E\u4E16\u754C\u3002\u674E\u51B0\uFF08\u614C\u4E71\uFF09\u7B49\u7B49\u7B49\u7B49\uFF01\u6211\u8FD8\u6CA1\u8BF4\u6211\u8981\u4E0D\u8981\u7B54\u5E94\u5462\uFF01\uFF01\u6211\u8981\u9000\u8BA2\u554A\u554A\u554A\u554A\uFF01\uFF01NPC\u672C\u6B21\u4EFB\u52A1\u5171\u6709\u56DB\u4E2A\u5173\u5361\uFF0C\u6BCF\u5B8C\u6210\u4E00\u4E2A\u5173\u5361\u540E\u83B7\u5F97\u5BF9\u5E94\u90FD\u6C5F\u5830\u56FE\u7EB8\u788E\u7247\u3002\u96C6\u9F50\u6240\u6709\u788E\u7247\uFF0C\u6210\u529F\u4FEE\u5EFA\u90FD\u6C5F\u5830\uFF0C\u5373\u53EF\u8FD4\u56DE\u73B0\u5B9E\u4E16\u754C\u3002NPC\u4EBA\u4EEC\u5728\u674E\u51B0\u7684\u5E26\u9886\u4E0B\u4E0D\u65AD\u52B3\u4F5C\uFF0C\u90FD\u6C5F\u5830\u5DE5\u7A0B\u4E5F\u5F97\u4EE5\u521D\u89C1\u96CF\u5F62\u3002\u4F46\u968F\u7740\u4FEE\u5EFA\u4E0D\u65AD\u8FDB\u884C\uFF0C\u65B0\u7684\u95EE\u9898\u518D\u4E00\u6B21\u51FA\u73B0......\u674E\u51B0\uFF08\u6B63\u4ED4\u7EC6\u89C2\u5BDF\u4E66\u684C\u4E0A\u7684\u4FEE\u5EFA\u56FE\u7EB8\uFF0C\u5BDF\u89C9\u5230\u4F60\u7684\u52A8\u9759\uFF09\u4E8C\u90CE\uFF0C\u4F60\u6765\u4E86\uFF1F\u6211\uFF08\u4F5C\u63D6\u884C\u793C\uFF09\u7236\u4EB2\uFF0C\u4E0D\u77E5\u60A8\u53EC\u6211\u524D\u6765\u6240\u4E3A\u4F55\u4E8B\uFF1F\u674E\u51B0\u90FD\u6C5F\u5830\u5DE5\u7A0B\u672C\u662F\u4E3A\u4E86\u89E3\u51B3\u6C34\u60A3\u95EE\u9898\u800C\u63D0\u51FA\uFF0C\u7136\u5219\u8FD9\u6C34\u52BF\u6C79\u6D8C\uFF0C\u6B32\u8981\u5316\u89E3\u5176\u5DE8\u5927\u4E4B\u529B\uFF0C\u5C82\u662F\u6613\u4E8B\uFF1F\u4F9D\u4F60\u770B\u6765\uFF0C\u5E94\u5F53\u5982\u4F55\u554A\uFF1F\u6211\uFF08\u601D\u7D22\u826F\u4E45\uFF09\u5B69\u513F\u611A\u949D\uFF0C\u5C1A\u8BF7\u7236\u4EB2\u6307\u70B9\u4E00\u4E8C\u3002\u674E\u51B0\u6C34\u60A3\u4E4B\u6E90\uFF0C\u6B63\u662F\u6C34\u6D41\u4E0D\u5747\uFF0C\u6CDB\u6EE5\u4E0E\u65AD\u6D41\u5E76\u5B58\uFF0C\u96BE\u4EE5\u6CBB\u7406\u3002\u6B32\u5316\u89E3\u6B64\u96BE\uFF0C\u9700\u5148\u884C\u5206\u6D41\uFF0C\u8C03\u914D\u6C34\u52BF\u3002\u82E5\u5C06\u6C34\u6D41\u5747\u5300\u5206\u914D\uFF0C\u5185\u6C5F\u4FBF\u53EF\u5F97\u4EE5\u758F\u901A\uFF0C\u5916\u6C5F\u5219\u80FD\u786E\u4FDD\u6C34\u6E90\u4E0D\u7AED\u3002\u4F60\u53EF\u77E5\u5176\u4E2D\u9053\u7406\uFF1F\u6211\uFF08\u542C\u4E86\u674E\u51B0\u7684\u8BDD\uFF0C\u4E00\u4E9B\u719F\u6089\u7684\u77E5\u8BC6\u9690\u7EA6\u6D6E\u73B0\u5728\u4F60\u7684\u8111\u6D77\uFF09\u5B69\u513F\u61C2\u4E86\uFF0C\u51E1\u5824\u6709\u51B2\u51B3\u4E4B\u865E\uFF0C\u5FC5\u7B51\u5206\u6C34\u4E4B\u6E20\uFF0C\u4EE5\u6740\u6C34\u52BF\uFF0C\u6563\u6C34\u529B\u800C\u56FA\u5176\u6839\u3002\u3002\u674E\u51B0\uFF08\u6B23\u6170\u7B11\u9053\uFF09\u5B7A\u5B50\u53EF\u6559\u4E5F\u3002NPC\u672C\u8F6E\u5173\u5361\u610F\u5728\u201C\u5206\u6C34\u201D\u3002\u6E38\u620F\u573A\u666F\u968F\u673A\u4EA7\u751F\u6E05\u6C34\u4E0E\u6C61\u6C34\uFF0C\u4F60\u9700\u8981\u901A\u8FC7\u7EBF\u6761\u5F15\u5BFC\u6C34\u6EF4\u6D41\u5411\uFF0C\u4F7F\u4E4B\u704C\u6E89\u4E2D\u95F4\u5C0F\u8349\u3002\u9F20\u6807\u5DE6\u952E\u4EA7\u751F\u7EBF\u6761\uFF0C\u9F20\u6807\u53F3\u952E\u64E6\u9664\u7EBF\u6761\u3002\u8BF7\u6CE8\u610F\u6E05\u6C34\u4F7F\u5C0F\u8349\u6210\u957F\uFF0C\u6C61\u6C34\u4F7F\u5C0F\u8349\u67AF\u840E\u3002\u79EF\u7D2F\u4E00\u5B9A\u5206\u6570\u540E\uFF0C\u5C0F\u8349\u6210\u529F\u957F\u5927\uFF0C\u89C6\u4E3A\u5173\u5361\u6311\u6218\u6210\u529F\uFF0C\u53EF\u83B7\u5F97\u76F8\u5E94\u788E\u7247\u3002\u300A\u6CB3\u5357\u901A\u5FD7\u300B\u5377\u5341\u516D
      43 \u53C8\u66F0\u6CBB\u9EC4\u6CB3\u4E4B\u6D45\u8005\uFF0C\u65E7\u5236\u5217\u65B9\u821F\u6570\u767E\u5982\u5899\uFF0C\u800C\u4EE5\u4E94\u9F7F\u722C\u674F\u53F6\u6753\u758F\u5E95\u4E58\u6D41\u51B2\u53BB\u3002\u4E0D\u77E5\u4E0A\u758F\u5219\u4E0B\uFF0C\u79EF\u6B64\u6DF1\u5219\u5F7C\u6DE4\uFF0C\u5948\u4F55\u4EE5\u4EBA\u529B\u80DC\u6CB3\u529B\u54C9\uFF1F\u4EE5\u4EBA\u6CBB\u6CB3\uFF0C\u4E0D\u5982\u4EE5\u6CB3\u6CBB\u6CB3\u3002\u5982\u6B32\u6DF1\u5317\uFF0C\u5219\u5357\u5176\u5824\u800C\u5317\u81EA\u6DF1\u3002\u5982\u6B32\u6DF1\u5357\u5219\u5317\u5176\u5824\u800C\u5357\u81EA\u6DF1\u3002\u5982\u6B32\u6DF1\u4E2D\uFF0C\u5219\u5357\u5317\u5176\u5824\u4E24\u675F\u4E4B\u903C\uFF0C\u6CB3\u6D41\u51B2\u4E2D\u800C\u4E2D\u81EA\u6DF1\uFF0C\u6B64\u501F\u5176\u6027\u800C\u5F79\u5176\u529B\u4E5F\u3002\u5176\u59CB\u4E5F\uFF0C\u5047\u5824\u4EE5\u4F7F\u6CB3\u4E4B\u6DF1\u3002\u5176\u7EC8\u4E5F\uFF0C\u6CB3\u6DF1\u800C\u4EFB\u5824\u4E4B\u6BC1\uFF0C\u82E5\u6B32\u6D45\u6CB3\u4EE5\u4E3A\u6D32\uFF0C\u4F46\u5F53\u53CD\u7528\u4E4B\u8033\u3002\u5176\u6CD5\u4E3A\u4E4B\u56FA\uFF0C\u5824\u4EE4\u6DA8\u53EF\u5F97\u800C\u903E\u4E5F\u3002\u6DA8\u51B2\u4E4B\u4E0D\u53BB\u800C\u53C8\u903E\u5176\u9876\uFF0C\u6DA8\u843D\u5219\u5824\u590D\u969C\uFF0C\u6025\u6D41\u4F7F\u4E4B\u522B\u51FA\u800C\u5824\u5916\u6C34\u7686\u7F13\uFF0C\u56FA\u5824\u4E4B\u5916\u6089\u6DE4\u4E3A\u6D32\u77E3\u3002_\u8D77\u59CB\u4F4D\u7F6E\u7EC8\u6B62\u9AD8\u5EA6\u5BBD\u4FEF\u89C6\u56FE\u622A\u9762\u8FD0\u884C_\u6CE5\u6C99\u51B2\u5237\u91CF\u704C\u6E89\u4F9B\u6C34\u91CF\u4E0D\u8DB3\u4FEE\u6539\u8C03\u6574\u4F4D\u7F6E\u8BF7\u5F53\u524D\u6D41\u901F\u8BF7\u6CBF\u865A\u7EBF\u786E\u5B9A\u5830\u7684\u4F4D\u7F6E\u9F20\u6807\u6309\u4E0B\u4E3A\u8D77\u70B9\u9F20\u6807\u677E\u5F00\u4E3A\u7EC8\u70B91234567890\u300A\u5929\u5DE5\u5F00\u7269\u300B\u4E2D\u7BC7\u7B2C\u5341\u4E00\u71D4\u77F3\u65B9\u5BB6\u4EE5\u78C1\u77F3\u78E8\u9488\u950B\uFF0C\u5219\u80FD\u6307\u5357\uFF0C\u7136\u5E38\u5FAE\u504F\u4E1C\uFF0C\u4E0D\u5168\u5357\u4E5F\uFF0C\u6C34\u6D6E\u591A\u8361\u6447\u3002\u6307\u722A\u53CA\u7897\u5507\u4E0A\u7686\u53EF\u4E3A\u4E4B\uFF0C\u8FD0\u8F6C\u5C24\u901F\uFF0C\u4F46\u575A\u6ED1\u6613\u5760\uFF0C\u4E0D\u82E5\u7F15\u60AC\u4E3A\u6700\u5584\u3002\u5176\u6CD5\u53D6\u65B0\u7EA9\u4E2D\u72EC\u8327\u7F15\uFF0C\u4EE5\u82A5\u5B50\u8BB8\u8721\uFF0C\u7F00\u4E8E\u9488\u8170\uFF0C\u65E0\u98CE\u5904\u60AC\u4E4B\uFF0C\u5219\u9488\u5E38\u6307\u5357\u3002\u300A\u68A6\u6EAA\u7B14\u8C08\u300B\u5377\u4E8C\u5341\u56DB\u5148\u53D6\u7164\u70AD\u3001\u6CE5\u548C\u505A\u6210\u997C\uFF0C\u6BCF\u7164\u997C\u4E00\u5C42\uFF0C\u5792\u77F3\u4E00\u5C42\uFF0C\u94FA\u85AA\u5176\u5E95\uFF0C\u707C\u706B\u71D4\u4E4B\u3002\u6700\u4F73\u8005\u66F0\u77FF\u7070\uFF0C\u6700\u6076\u8005\u66F0\u7A91\u6ED3\u7070\u3002\u706B\u529B\u5230\u540E\uFF0C\u70E7\u9165\u77F3\u6027\uFF0C\u7F6E\u4E8E\u98CE\u4E2D\uFF0C\u4E45\u81EA\u5439\u5316\u6210\u7C89\u3002\u6025\u7528\u8005\u4EE5\u6C34\u6C83\u4E4B\uFF0C\u4EA6\u81EA\u89E3\u6563\u3002\uFF1A:\u65F1\u52B3\u7686\u4EE5\u4E3A\u6C11\u5BB3\u5C82\u76F4\u5730\u52BF\u4F7F\u7136\u54C9\u5351\u804C\u8385\u4EFB\u4E09\u7A14\u7686\u9047\u65F1\u9884\u8BA1\u6C34\u5229\u4E3A\u7B51\u9676\u5BB6\u5830\u695A\u6C49\u6CC9\u7B49\u9738\u62FE\u6570\u5904\u51E1\u8FD1\u9738\u4E4B\u7530\u5F97\u6C34\u704C\u6F11\u4FF1\u83B7\u5168\u719F\u53CA\u79CB\u540E\u6DEB\u9716\u652F\u6D41\u5C31\u58D1\u800C\u4EA6\u65E0\u51B2\u51B3\u4E4B\u865E\u662F\u7B51\u5824\u660E\u9A8C\u4E5F\u4E3A\u5176\u4E8B\u65E0\u5176\u529F\u8005\u672A\u5C1D\u7779\u4E4B\u4E5F\u672C\u8F6E\u5173\u5361\u73A9\u5BB6\u9700\u901A\u8FC7\u786E\u5B9A\u98DE\u6C99\u5830\u7684\u4F4D\u7F6E\u3001\u8C03\u6574\u98DE\u6C99\u5830\u9AD8\u5EA6\uFF0C\u5229\u7528\u6C34\u6D41\u5E26\u8D70\u5185\u6C5F\u7684\u6CE5\u6C99\uFF0C\u9632\u6B62\u6DE4\u79EF\uFF0C\u5E76\u4E14\u540C\u65F6\u9700\u8981\u786E\u4FDD\u704C\u6E89\u91CF\u3002\u6545\u4E8B\u5927\u7EB2\uFF08\u5F00\u5934\u548C\u7ED3\u5C3E\u53CA\u5206\u955C\uFF09\u6545\u4E8B\u6897\u6982\uFF1A\u5927\u5B66\u751FXX\u4E3A\u5B8C\u6210\u4EE5\u201C\u90FD\u6C5F\u5830\u7684\u5EFA\u9020\u201D\u4E3A\u4E3B\u9898\u7684\u5C0F\u7EC4\u4F5C\u4E1A\uFF0C\u5468\u672B\u4E0E\u540C\u5B66\u5171\u540C\u6765\u5230\u90FD\u6C5F\u5830\u8FDB\u884C\u8C03\u7814\u5B66\u4E60\u3002\u7136\u800C\u5728\u8003\u5BDF\u4E8C\u738B\u5E99\u65F6\uFF0C\u4E3B\u4EBA\u516C\u88AB\u5E99\u4E2D\u4F9B\u5949\u7684\u4E8C\u90CE\u795E\u50CF\u6240\u5438\u5F15\u3002\u4E0D\u77E5\u8FC7\u4E86\u591A\u4E45\uFF0C\u6709\u4EBA\u62CD\u4E86\u62CD\u4E3B\u4EBA\u516C\u7684\u80A9\u8180\uFF0C\u4E3B\u4EBA\u516C\u4E00\u4E0B\u56DE\u8FC7\u795E\u6765\uFF0C\u60CA\u51FA\u4E00\u8EAB\u51B7\u6C57\uFF0C\u56DE\u5934\u53EA\u89C1\u795E\u50CF\u4E0E\u5E99\u5B87\u7686\u4E0D\u89C1\u8E2A\u5F71\uFF0C\u552F\u4E00\u957F\u987B\u6218\u56FD\u670D\u9970\u7684\u8001\u6C49\u7AD9\u5728\u4ED6\u8EAB\u4FA7\uFF0C\u90A3\u4EBA\u76F4\u547C\u4ED6\u4E8C\u90CE\uFF0C\u751A\u662F\u4EB2\u6635\u3002\u7ECF\u8FC7\u4E00\u756A\u4EA4\u8C08\uFF0C\u4E3B\u4EBA\u516C\u5F97\u77E5\u81EA\u5DF1\u7ADF\u9B42\u7A7F\u6210\u4E86\u674E\u51B0\u4E4B\u5B50\u674E\u4E8C\u90CE\uFF0C\u4E0E\u6B64\u540C\u65F6\u7A7F\u8D8A\u5FC5\u5907\u7684\u91D1\u624B\u6307\u201C\u7CFB\u7EDF\u201D\u767B\u573A\uFF0C\u4E3A\u4E3B\u89D2\u8BBE\u5B9A\u4E86\u201C\u5B8C\u6210\u90FD\u6C5F\u5830\u5EFA\u8BBE\u624D\u80FD\u56DE\u5BB6\u201D\u7684\u7EC8\u6781\u76EE\u6807\uFF0C\u5728\u5173\u952E\u65F6\u523B\uFF0C\u7CFB\u7EDF\u5C06\u7ED9\u4E88\u4E3B\u89D2\u4E0E\u4E2D\u56FD\u53E4\u4EE3\u5404\u4E2A\u76F8\u5173\u79D1\u5B66\u5BB6\u76F8\u89C1\u5B66\u4E60\u7684\u673A\u4F1A\uFF0C\u5B66\u4E60\u597D\u77E5\u8BC6\u540E\uFF0C\u5373\u53EF\u56DE\u5230\u90FD\u6C5F\u5830\u5EFA\u8BBE\u5F53\u4E2D\uFF0C\u63A8\u52A8\u90FD\u6C5F\u5830\u7684\u5B8C\u6210\u3002\u7532\u4E3A\u84DD\u8863\u7537\uFF0C\u4E59\u4E3A\u7D2B\u88D9\u5973\uFF0C\u4E19\u4E3A\u77ED\u53D1\u5973\uFF0C\u4E3B\u89D2\u4E3A\u767D\u8863\u7537\u3002\u573A\u666F\u4E00\uFF1A\u708E\u708E\u590F\u65E5\u4E3B\u4EBA\u516C\u7A7F\u884C\u4E8E\u90FD\u6C5F\u5830\u666F\u533A\u884C\u9053\u4E0A\uFF0C\u4F17\u4EBA\u4EA4\u4EE3\u6765\u6B64\u76EE\u5206\u955C1\uFF1A\u666F\u89C2\u5C0F\u9053\uFF0C\u9633\u5149\u7A7F\u8FC7\u6811\u53F6\u843D\u5728\u5730\u4E0A\uFF0C\u63A5\u8FD1\u6B63\u5348\u65F6\u5206\u3002\u7532\u4E59\u4E19\u5728\u524D\uFF0C\u4E3B\u89D2\u7A0D\u843D\u540E\u3002\u7532\uFF08\u559D\u6C34\uFF09\uFF1A\u5929\u597D\u70ED\u554A\uFF0C\u4E3A\u4E86\u5C0F\u7EC4\u4F5C\u4E1A\u54B1\u4EEC\u4E5F\u662F\u62FC\u4E86\u3002\u4E59\uFF08\u5F2F\u8170\u76F8\u673A\u62CD\u5468\u906D\u73AF\u5883\uFF09\uFF1A\u90A3\u4F60\u8FD8\u4E0D\u591A\u591A\u8BB0\u5F55\u4E0B\u6709\u7528\u4FE1\u606F\uFF0C\u90FD\u6C5F\u5830\u53EF\u4E0D\u662F\u5C0F\u5DE5\u7A0B\u3002\uFF08\u8868\u60C5\u53D8\u5316\uFF09\u5176\u4E2D\u590D\u6742\u53C8\u7CBE\u7EC6\u7684\u7269\u7406\u539F\u7406\u8FD8\u662F\u5F88\u503C\u5F97\u6211\u4EEC\u8DD1\u8FD9\u4E00\u906D\u7684\u3002\u4E19\uFF08\u624B\u6301\u5730\u56FE\uFF09\uFF1A\u518D\u8D70\u4E24\u516C\u91CC\u5C31\u5230\u4E8C\u738B\u5E99\u4E86\uFF0C\u54B1\u4EEC\u53EF\u4EE5\u8FDB\u53BB\u4F11\u606F\u4E00\u4E0B\u3002\u4E3B\u89D2\uFF1A\u8FD8\u6709\u4E24\u516C\u91CC\u554A\u2026\u5206\u955C2\uFF1A\u4F17\u4EBA\u5411\u4E8C\u738B\u5E99\u65B9\u5411\u8D70\u53BB\uFF0C\u4E0D\u8FDC\u5904\u663E\u73B0\u5E99\u5B87\u7684\u5F62\u72B6\uFF0C\u4E3B\u89D2\u9644\u8EAB\u770B\u77F3\u523B\u3002\u5206\u955C3\uFF1A\u77F3\u523B\u5185\u5BB9\uFF08\u674E\u51B0\u4E4B\u5B50\u2014\u2014\u674E\u4E8C\u90CE\uFF0C\u4E3A\u4E8C\u90CE\u795E\u4E4B\u8BF4\uFF09\u5206\u955C4\uFF1A\u4E3B\u89D2\u4ECD\u8E72\u5728\u77F3\u523B\u65C1\uFF0C\u7709\u76EE\u95F4\u82E5\u6709\u6240\u601D\uFF0C\u8FDC\u5904\u4E19\u56DE\u5934\uFF0C\u53D1\u73B0\u4E3B\u89D2\u672A\u8DDF\u4E0A\u3002\u4E3B\u89D2\uFF08\u788E\u788E\u5FF5\uFF09\uFF1A\u674E\u4E8C\u90CE......\u4E8C\u90CE\u795E\uFF1F\u4E19\uFF08\u56DE\u5934\u62DB\u624B\uFF09\uFF1A\u5582\uFF0CXX\uFF0C\u5E72\u561B\u5462\uFF0C\u5FEB\u70B9\u8DDF\u4E0A\u6765\u3002\u5206\u955C5\uFF1A\uFF08\u4FEF\u62CD\uFF0C\u4E19\u89C6\u89D2\uFF09\u4E3B\u89D2\u8D77\u8EAB\u62DB\u624B\uFF08\u4E0E\u77F3\u523B\u540C\u6846\uFF09\u30023.1\u4E3B\u89D2\uFF08\u5F00\u6717\uFF09\uFF1A\u6765\u5566\uFF01\u7B49\u7B49\u6211\uFF01\u5206\u955C6\uFF1A\u5207\u77F3\u523B\u8FD1\u666F\uFF0C\u4E8C\u90CE\u795E\u51E0\u4E2A\u5B57\u9690\u9690\u95EA\u51FA\u91D1\u5149\u3002\u573A\u666F\u4E8C\uFF1A\u4F17\u4EBA\u8FDB\u5165\u4E8C\u738B\u5E99\uFF0C\u56DB\u5904\u67E5\u770B\u63A2\u7A76\uFF0C\u4E3B\u89D2\u671B\u50CF\u51DD\u795E\u7A7F\u8D8A\u30023.3\u4E19\uFF08\u4E00\u53EA\u811A\u8DE8\u5165\u95E8\u69DB\uFF0C\u624B\u63E1\u5730\u56FE\uFF09\uFF1A\u73B0\u5728\u5728\u54B1\u4EEC\u9762\u524D\u7684\u5C31\u662F\u4E8C\u738B\u5E99\u4F9B\u5949\u7684\u4E8C\u738B\u4E4B\u4E00\u2014\u2014\u674E\u4E8C\u90CE\u7684\u50CF\u4E86\u3002\u4E59\uFF08\u4E00\u53EA\u811A\u8FC8\u5165\u95E8\u69DB\uFF0C\u4E00\u53EA\u624B\u63E1\u76F8\u673A\uFF0C\u4E00\u53EA\u624B\u62CD\u65C1\u8FB9\u7532\u7684\u80A9\u8180\uFF09\uFF1A\u54E6\u54E6\uFF0C\u6211\u77E5\u9053\u4E3B\u89D2\uFF08\u6B63\u5BF9\u795E\u50CF\uFF09\uFF1A\u8FD9\u5C31\u662F\u674E\u4E8C\u90CE\u2014\u2014\u4F20\u8BF4\u4E2D\u7684\u4E8C\u90CE\u795E\u5417......\u5206\u955C2\uFF1A\u5207\u795E\u50CF\u8FD1\u666F\uFF0C\u66F4\u663E\u5149\u5F69\u593A\u76EE\uFF0C\u5EA7\u524D\u4F9B\u5949\u9999\u706B\uFF0C\u70DF\u96FE\u7F2D\u7ED5\u5374\u6321\u4E0D\u4F4F\u5851\u50CF\u7684\u795E\u91C7\u3002\u5206\u955C3\uFF1A\u4E3B\u89D2\u8D70\u5411\u795E\u575B\u524D\u7684\u8F6F\u57AB\uFF0C\u4F9D\u7136\u662F\u80CC\u5F71\u3002\u805A\u7126\u80CC\u5F71\uFF0C\u865A\u795E\u50CF\u3002\u5206\u955C4\uFF1A\u4E3B\u89D2\u8DEA\u4FEF\u5728\u8F6F\u57AB\u4E0A\uFF0C\u865A\u80CC\u5F71\uFF0C\u805A\u7126\u795E\u50CF\uFF0C\u886C\u6258\u795E\u50CF\u4E4B\u5149\u4F1F\u3002\u5206\u955C5\uFF1A\u5207\u4E3B\u89D2\u89C6\u89D2\uFF0C\u8D77\u8EAB\uFF0C\u4ECD\u5C31\u8DEA\u5750\u5206\u955C6\uFF1A\u4E3B\u89D2\u89C6\u89D2\uFF0C\u955C\u5934\u4E0A\u79FB\uFF0C\u795E\u50CF\u4E4B\u5A01\u6B66\u5206\u955C7\uFF1A\u4E3B\u89D2\u8679\u819C\u6620\u51FA\u795E\u50CF\u7684\u5F71\u5B50\u5206\u955C8\uFF1A\u955C\u5934\u4E0D\u65AD\u63A8\u8FDB\u5206\u955C9\uFF1A\u9ED1\u5C4F\u573A\u666F\u4E09\uFF1A\u4E3B\u89D2\u53E4\u88C5\u6253\u626E\uFF0C\u7AD9\u7ACB\u5C71\u5934\uFF0C\u811A\u4E0B\u662F\u6C79\u6D8C\u7684\u5CB7\u6C5F\u6C34\uFF0C\u8EAB\u65C1\u4E00\u957F\u987B\u592A\u5B88\u4E0E\u4E4B\u4EA4\u8C08\u3002\u5206\u955C1\uFF1A\u9ED1\u6697\u4E2D\u51FA\u73B0\u767D\u5149\u3002\u5206\u955C2\uFF1A\u767D\u5149\u3002\u5206\u955C3\uFF1A\u767D\u5149\u4E2D\u8FF7\u8FF7\u7CCA\u7CCA\u663E\u73B0\u51FA\u5BF9\u9762\u7684\u6CE5\u6CDE\u5C71\u5934\u548C\u811A\u4E0B\u6C79\u6D8C\u7684\u6C5F\u6C34\u3002\u5206\u955C4\uFF1A\u4E00\u53EA\u624B\u8F7B\u62CD\u53E6\u4E00\u4EBA\u80A9\u5934\u3002\u5206\u955C5\uFF1A\u4E3B\u89D2\u60CA\u6050\u8138\u56DE\u5934\uFF0C\u8138\u4E0A\u5C3D\u662F\u6C57\u73E0\u3002\u5206\u955C6\uFF1A\u4E3B\u89D2\u89C6\u89D2\uFF0C\u4E00\u957F\u987B\u4E2D\u5E74\u7537\u4EBA\uFF0C\u8EAB\u7740\u4F3C\u662F\u67D0\u671D\u5B98\u670D\uFF0C\u62C5\u5FE7\u5730\u671B\u5411\u4E3B\u89D2\u3002\u7537\u4EBA\uFF08\u4E00\u624B\u89E6\u4E0A\u4E3B\u89D2\u80A9\u5934\uFF09\uFF1A\u4E8C\u90CE\uFF0C\u8FD9\u662F\u600E\u4E48\u4E86\uFF1F\u5206\u955C7\uFF1A\u7537\u4EBA\u4E00\u624B\u629A\u80E1\u987B\uFF0C\u4E00\u624B\u80CC\u540E\uFF0C\u795E\u6001\u5FE7\u6101\u3002\u7537\u4EBA\uFF1A\u770B\u6765\u8FD9\u5CB7\u6C5F\u6C34\u60A3\u5F62\u52BF\u4E25\u5CFB\uFF0C\u8FD8\u662F\u9700\u8981\u4E00\u9053\u5830\u6765\u89E3\u51B3\u95EE\u9898\u3002\u5206\u955C8\uFF1A\u4E3B\u89D2\u5446\u7ACB\uFF0C\u82E5\u6709\u6240\u601D\u3002\u4E3B\u89D2\uFF08\u5FC3\u60F3\uFF09\uFF1A\u201C\u53E4\u88C5\u201D\u201C\u4E8C\u90CE\u201D\u201C\u5830\u201D\u83AB\u975E.......\u5206\u955C9\uFF1A\u955C\u5934\u56DE\u5230\u5206\u955C7\uFF0C\u5728\u6B64\u57FA\u7840\u4E0A\u663E\u793A\u7CFB\u7EDF\u5C4F\u5E55\u3002\u7CFB\u7EDF\uFF1A\u5BBF\u4E3B\uFF0C\u60A8\u597D\u3002\u7CFB\u7EDF\u68C0\u6D4B\u5230\u60A8\u4E0E\u4E8C\u90CE\u795E\u7684\u547D\u8FD0\u7EBF\u53D7\u65F6\u7A7A\u5F71\u54CD\uFF0C\u53D1\u751F\u6CE2\u52A8\uFF0C\u4EA7\u751F\u7EA0\u845B\uFF0C\u73B0\u5DF2\u5C06\u60A8\u4F20\u9001\u81F3\u4E8C\u90CE\u795E\u51E1\u80CE\u2014\u2014\u674E\u4E8C\u90CE\u4E4B\u8EAB\uFF0C\u8BF7\u7AED\u529B\u5E2E\u52A9\u674E\u4E8C\u90CE\u53CA\u5176\u7236\u674E\u51B0\u5B8C\u6210\u90FD\u6C5F\u5830\u7684\u4FEE\u5EFA\uFF0C\u7406\u6E05\u547D\u8FD0\u7EBF\uFF0C\u89E3\u9664\u7EA0\u845B\uFF0C\u56DE\u5230\u73B0\u5B9E\u4E16\u754C\u3002\u4EE5\u4E0B\u662F\u60A8\u7684\u65B0\u624B\u6559\u5B66......\u8DF3\u8F6C\u6E38\u620F\u5927\u5385\u754C\u9762\uFF0C\u5F15\u5165\u65B0\u624B\u6E38\u620F\u6307\u5BFC\u3002\u73A9\u5BB6\u5F00\u59CB\u5267\u60C5\uFF08\u8FDE\u8D2F\u4E3B\u5267\u60C5\uFF09\uFF0C\u5267\u60C5\u4E0A\u78B0\u5230\u95EE\u9898\uFF0C\u968F\u540E\u663E\u793A\u6E38\u620F\u5173\u5361\uFF0C\u8FD4\u56DE\u6E38\u620F\u754C\u9762\uFF0C\u4E0E\u76F8\u5E94\u7269\u7406\u5B66\u5BB6\u4EA4\u8C08\u5E76\u6DF1\u5165\u5B66\u4E60\u5176\u77E5\u8BC6\uFF08\u7269\u7406\u5B66\u5BB6\u652F\u7EBF\u5267\u60C5\u2014\u2014\u6B64\u5904\u80CC\u666F\u4E3A\u7269\u7406\u5B66\u5BB6\u7684\u8457\u4F5C\u4E66\u9875\u5C55\u793A\uFF0C\u6807\u4EAE\u5173\u952E\u53E5/\u62DF\u8BA2\uFF09\uFF0C\u5B8C\u6210\u76F8\u5E94\u5173\u5361\u65B0\u624B\u6559\u5B66\u53CA\u521D\u7EA7\u5173\u5361\u901A\u5173\uFF0C\u8FD4\u56DE\u4E3B\u5267\u60C5\uFF0C\u5B8C\u6210\u6E38\u620F\u5173\u5361\uFF0C\u5B8C\u6210\u540E\u83B7\u5F97\u4E00\u7247\u90FD\u6C5F\u5830\u56FE\u7EB8\u788E\u7247\uFF0C\u96C6\u9F50\u6240\u6709\u788E\u7247\uFF0C\u7EC4\u6210\u4E00\u5E45\u5B8C\u6574\u56FE\u7EB8\u540E\u5373\u8DF3\u5165\u6E38\u620F\u7ED3\u7B97\u52A8\u753B\u753B\u9762\u3002\u6E38\u620F\u7ED3\u7B97\uFF1A\u6700\u540E\u4E00\u7247\u788E\u7247\u62FC\u597D\uFF0C\u56FE\u7EB8\u6210\u578B\uFF0C\u8DF3\u8F6C\u7ED3\u7B97\u52A8\u753B\u3002\u573A\u666F\u4E00\uFF1A\u4E3B\u89D2\u7AD9\u7ACB\u5728\u90FD\u6C5F\u5830\u7EDD\u4F73\u89C2\u8D4F\u5C71\u5934\uFF0C\u811A\u4E0B\u662F\u5B8F\u4F1F\u7CBE\u5999\u7684\u90FD\u6C5F\u5830\u6C34\u5229\u5DE5\u7A0B\u548C\u201C\u6E29\u9A6F\u201D\u7684\u5CB7\u6C5F\u6C34\u3002\u5206\u955C1\uFF1A\u4E3B\u89D2\u89C6\u89D2\uFF0C\u624B\u6301\u5B8C\u6574\u56FE\u7EB8\u811A\u4E0B\u5F71\u5F71\u7EF0\u7EF0\u7684\u662F\u90FD\u6C5F\u5830\u548C\u5CB7\u6C5F\u6C34\u3002\u5206\u955C2\uFF1A\u4E3B\u89D2\u89C6\u89D2\uFF0C\u674E\u51B0\u7B11\uFF0C\u4E00\u624B\u629A\u987B\uFF0C\u4E00\u624B\u642D\u4E0A\u4E3B\u89D2\u80A9\u5934\u3002\r\n\u674E\u51B0\uFF1A\u4E8C\u90CE\uFF0C\u8FD9\u4E48\u591A\u5E74\uFF0C\u7EC8\u4E8E\u5C06\u8FD9\u5830\u4FEE\u6210\u4E86\uFF0C\u73B0\u5DF2\u5C06\u6B64\u4E8B\u4E0A\u62A5\u7ED9\u5927\u738B\u3002\u6211\u4EEC\u80FD\u4FEE\u6210\u6B64\u5DE5\u4E8B\uFF0C\u60F3\u6765\u662F\u80FD\u6D41\u4F20\u5343\u53E4\u7684\u5229\u6C11\u4E4B\u529F\u4E1A\uFF0C\u4E5F\u591A\u4E8F\u6B64\u5730\u767E\u59D3\u9F50\u5FC3\u534F\u529B\u6CBB\u7406\u6C34\u60A3\uFF0C\u5982\u4ECA\u4F60\u6211\u5C3D\u53EF\u4E50\u4E5F\uFF0C\u540C\u6211\u524D\u53BB\u4E0E\u6C11\u6B22\u5E86\u5427\u3002\u5206\u955C3\uFF1A\u7B11\u5BB9\u5B9A\u683C\u5728\u674E\u51B0\u8138\u4E0A\uFF0C\u5982\u521A\u6765\u8FD9\u4E2A\u4E16\u754C\u4E00\u822C\u7684\u666F\u8C61\uFF0C\u7CFB\u7EDF\u5728\u6B64\u65F6\u8DF3\u4E86\u51FA\u6765\u3002\u7CFB\u7EDF\uFF1A\u606D\u559C\u5BBF\u4E3B\uFF0C\u547D\u8FD0\u7EBF\u5DF2\u7406\u6E05\uFF0C\u4EFB\u52A1\u5B8C\u6210\uFF0C\u60A8\u5373\u5C06\u91CD\u8FD4\u73B0\u5B9E\u4E16\u754C\u3002\u5206\u955C4\uFF1A\u5982\u5206\u955C3\uFF0C\u56DB\u5468\u6F2B\u8D77\u9ED1\u96FE\u3002\u5206\u955C5\uFF1A\u9ED1\u5C4F\u3002\u573A\u666F\u4E8C\uFF1A\u4E3B\u89D2\u7ACB\u4E8E\u6BBF\u5185\uFF0C\u795E\u50CF\u524D\uFF0C\u540C\u884C\u597D\u53CB\u524D\u6765\u642D\u8BDD\u3002\u5206\u955C1\uFF1A\u9ED1\u6697\u4E2D\u663E\u51FA\u4E00\u884C\u5B57\uFF1A\u5929\u673A\u7384\u5999\u4E0D\u53EF\u8A00\uFF0C\u5207\u52FF\u7EA0\u7F20\u7559\u4F59\u6CE2\u3002\u5206\u955C2\uFF1A\u9ED1\u6697\u4E2D\u6709\u767D\u5149\u3002\u5206\u955C3\uFF1A\u767D\u5149\u3002\u5206\u955C4\uFF1A\u767D\u5149\u4E2D\u6726\u6726\u80E7\u80E7\u663E\u73B0\u51FA\u795E\u50CF\u548C\u795E\u9F9B\u7684\u5F71\u5B50\u3002\uFF08\u4E0D\u77E5\u4F55\u65F6\u4E3B\u89D2\u5DF2\u8D77\u8EAB\uFF0C\u89C6\u7EBF\u504F\u4E0B\uFF09\u5206\u955C5\uFF1A\u7532\u624B\u91CD\u62CD\u4E3B\u89D2\u80A9\u5934\u3002\u5206\u955C6\uFF1A\u4E3B\u89D2\u56DE\u5934\uFF0C\u8EAB\u4FA7\u7AD9\u7740\u624B\u62FF\u51B0\u68D2\u7684\u7532\u3002\u7532\uFF08\u5F00\u6717\uFF0C\u9012\u624B\u91CC\u7684\u51B0\u68D2\uFF09\uFF1A\u4E00\u76F4\u76EF\u7740\u770B\u5565\u5462\uFF0C\u96BE\u9053\u662F\u8FD9\u795E\u50CF\u6709\u4EC0\u4E48\u7384\u673A\uFF1F\u77A7\u4F60\u8FD9\u6EE1\u5934\u5927\u6C57\u7684\uFF0C\u51B0\u68D2\u5206\u4F60\u4E00\u534A\u3002\u5206\u955C7\uFF1A\u4E3B\u89D2\u5A49\u62D2\uFF08\u8FD9\u5757\u6CA1\u60F3\u51FA\u6765\u573A\u666F\u5565\u6837\uFF09\u4E3B\u89D2\uFF08\u626F\u51FA\u4E00\u4E2A\u6D45\u6DE1\u7684\u5FAE\u7B11\uFF0C\u63A5\u8FC7\u51B0\u68D2\uFF09\uFF1A\u54C8\uFF0C\u6CA1\u4EC0\u4E48\u3002\u5206\u955C8\uFF1A\u7532\uFF0C\u4E3B\u89D2\u80CC\u671D\u795E\u50CF\u4E59\u3001\u4E19\u5411\u4ED6\u4EEC\u8D70\u6765\u3002\u4E19\uFF08\u624B\u6301\u5730\u56FE\uFF09\uFF1A\u597D\u4E86\uFF0C\u6211\u4EEC\u8BE5\u53BB\u4E0B\u4E00\u4E2A\u5730\u65B9\u4E86\u3002\u4E59\uFF08\u8116\u6302\u76F8\u673A\uFF0C\u4E3E\u8D77\u624B\u91CC\u7684\u7B14\u8BB0\u672C\uFF09\uFF1A\u5582\uFF0C\u53EB\u4F60\u4EEC\u6536\u96C6\u6709\u7528\u4FE1\u606F\uFF0C\u4F60\u4EEC\u6536\u96C6\u4E86\u6CA1\u6709\u3002\u7532\uFF08\u6320\u5934\uFF0C\u5634\u91CC\u542B\u7740\u51B0\u68D2\uFF0C\u8BAA\u7B11\uFF0C\u5192\u6C57\uFF09\uFF1A\u624B\u5199\u54EA\u6709\u8111\u5B50\u8BB0\u5F97\u5FEB\uFF0C\u6211\u4EEC\u90FD\u628A\u8D44\u6599\u8BB0\u8111\u888B\u91CC\u4E86\u3002\u4E3B\u89D2\uFF08\u624B\u6301\u51B0\u68D2\uFF0C\u6320\u5934\uFF0C\u8D54\u7B11\uFF09\uFF1A\u63A5\u4E0B\u6765\u4E00\u5B9A\u597D\u597D\u8BB0\u5F55\u3002\u5206\u955C9\uFF1A\u4E3B\u89D2\u56DB\u4EBA\u5411\u5E99\u5916\u8D70\u53BB\uFF0C\u90FD\u662F\u80CC\u5F71\u3002\u7532\uFF08\u53F3\u624B\u6301\u5403\u4E86\u4E00\u534A\u7684\u51B0\u68D2\uFF0C\u5DE6\u624B\u63FD\u4E0A\u4E3B\u89D2\u80A9\u8180\uFF09\uFF1A\u4F60\u521A\u521A\u5230\u5E95\u5728\u770B\u5565\u554A\u3002\u4E3B\u89D2\uFF08\u5DE6\u624B\u6293\u7532\u5DE6\u624B\uFF09\uFF1A\u4E0D\u8DB3\u4E3A\u5916\u4EBA\u9053\u4E5F\u3002\u4E59\u4E19\u6709\u8BF4\u6709\u7B11\u671D\u5916\u8FC8\u6B65\u3002\u5206\u955C10\uFF1A\u4F9D\u65E7\u662F\u56DB\u4EBA\u80CC\u5F71\uFF0C\u4E3B\u89D2\u56DE\u5934\uFF0C\u770B\u5411\u795E\u50CF\u3002\u5206\u955C11\uFF1A\u5207\u795E\u50CF\u9762\u90E8\u7279\u5199\uFF08\u71A0\u71A0\u751F\u8F89\uFF09\u3002\u5206\u955C12\uFF1A\u5DF2\u51FA\u5E99\u95E8\u7684\u56DB\u4EBA\u80CC\u5F71\u3002\u5206\u955C13\uFF1A\u795E\u50CF\u9762\u90E8\u7279\u5199\uFF0C\u5634\u89D2\u4E0A\u626C\u4E00\u4E2A\u50CF\u7D20\u70B9\u3002\u5B8C\u3002\u771F\u9634\u51C9\u5904\u6B47\u674E\u51B0\u4E8C\u90CE\uFF0C\u4E8C\u90CE\uFF1F\u8FD9\u662F\u600E\u4E48\u4E86\uFF1F\u4F60\u6211\u7236\u5B50\u88AB\u6D3E\u5F80\u6B64\u5730\u6CBB\u6C34\uFF0C\u8EAB\u8D1F\u91CD\u4EFB\uFF0C\u4E07\u8981\u4FDD\u91CD\u8EAB\u4F53\u554A\u3002\u4E3B\u89D2\uFF08\u4E8C\u90CE\uFF1F\u7236\u5B50\uFF1F\u6CBB\u6C34\uFF1F\u2026\u2026\uFF09\u674E\u51B0\u6211\u770B\u8FD9\u5CB7\u6C5F\u6C34\u60A3\u5F62\u52BF\u4E25\u5CFB\uFF0C\u8FD8\u662F\u9700\u8981\u4E00\u9053\u5830\u6765\u89E3\u51B3\u95EE\u9898\u3002\u4E3B\u89D2\uFF08\u6211\u600E\u4E48\u7A7F\u7740\u53E4\u88C5\uFF1F\u5830\uFF1F\u6211\u4E0D\u4F1A\u7A7F\u8D8A\u4E86\u5427\u2026\u2026\uFF09NPC\u4E3A\u4E86\u5E2E\u52A9\u5BBF\u4E3B\u4F60\u7684\u901A\u8FC7\u4E4B\u65C5\uFF0C\u6307\u5357\u9488\u73B0\u5DF2\u53D1\u653E\u5230\u4F60\u7684\u624B\u4E2D\uFF0C\u8BF7\u5BBF\u4E3B\u8DDF\u7740\u6307\u5357\u9488\u6307\u793A\u7684\u65B9\u5411\u524D\u8FDB\uFF0C\u4F9D\u6B21\u901A\u5173\u3002\u52A0\u6CB9\u54E6\uFF01\u7CFB\u7EDF\u7AED\u8BDA\u4E3A\u4F60\u670D\u52A1\u3002\u6D88\u9EC4\u949F\u751F\u6797\u949F\uFF0C\u6797\u949F\u751F\u592A\u851F\uFF0C\u592A\u851F\u751F\u5357\u5415\uFF0C\u5357\u5415\u751F\u59D1\u6D17\uFF0C\u59D1\u6D17\u751F\u5E94\u949F\uFF0C\u5E94\u949F\u751F\u8564\u5BBE\uFF0C\u8564\u5BBE\u751F\u5927\u5415\uFF0C\u5927\u5415\u751F\u5937\u5219\uFF0C\u5937\u5219\u751F\u5939\u949F\uFF0C\u5939\u949F\u751F\u65E0\u5C04\uFF0C\u65E0\u5C04\u751F\u4EF2\u5415\u3002\u4E09\u5206\u6240\u751F\uFF0C\u76CA\u4E4B\u4E00\u5206\u4EE5\u4E0A\u751F\u3002\u4E09\u5206\u6240\u751F\uFF0C\u53BB\u5176\u4E00\u5206\u4EE5\u4E0B\u751F\u3002\u300A\u5415\u6C0F\u6625\u79CB\u300B\u4E4B\u201C\u5B63\u590F\u7EAA\u7B2C\u516D\xB7\u97F3\u5F8B\uFF08